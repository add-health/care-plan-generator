ANTHROPIC_API_KEY=your_key_here
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Required on Railway. credentials.json is gitignored and cannot be placed in
# the container, so the service account is supplied through this variable
# instead. The value must be the service account JSON encoded as BASE64, not
# the raw JSON — server.js base64-decodes it before parsing:
#   macOS/Linux:  base64 -i credentials.json | pbcopy
# Leave it unset locally and the server falls back to reading ./credentials.json.
GOOGLE_CREDENTIALS_JSON=
